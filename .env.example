# Which LLM provider to use by default: "claude" or "openai"
LLM_PROVIDER=claude

ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Embeddings: "openai" or "local" (sentence-transformers, free, no API cost)
EMBEDDING_PROVIDER=local

# Single API key protecting your own endpoints (v1 = single user)
APP_API_KEY=change_this_to_a_random_string

# TMDB for movie module (free tier API key: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_key_here

# NewsAPI (free tier: https://newsapi.org) — or leave blank to use RSS only
NEWS_API_KEY=

CHROMA_PERSIST_DIR=./app/data/chroma
SQLITE_PATH=./app/data/app.db
